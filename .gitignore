# ───────────────────────────────────────────────────────────────
# FPGA — .gitignore
# Source-only repo: no Vivado artifacts, raw market data, or
# simulation caches.
# ───────────────────────────────────────────────────────────────

# ── System / editor noise ──
.DS_Store
**/.DS_Store
._*
Thumbs.db
*.swp
*.swo
*.tmp
*.temp
*.orig
*.bak

# ── opencode / agent ──
.opencode/skills/**/artifacts/
.opencode/*.local.json

# ── Python ──
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Market data (never commit real feeds) ──
data/itch_sample/**
!data/itch_sample/.gitkeep
*.NASDAQ_ITCH50.gz

# ── SBE MDP3 schemas (spec, but kept out of the repo — rule G0) ──
data/mdp3/**
!data/mdp3/.gitkeep

# ── Simulation (cocotb / Verilator) ──
sim_build/
**/sim_build/
**/sim_build_*/
**/obj_dir/
**/xsim.dir/
**/work/
*.vcd
*.fst
*.wlf
*.log
coverage/
**/coverage/
*.xml

# ── Vivado / synthesis ──
*.jou
*.log
*.backup
synth/*.runs/
synth/*.cache/
synth/*.hw/
synth/*.gen/
synth/*.ip_user_files/
synth/*.sim/
*.bit
*.bin
*.ltx
.idea/
.vscode/
# Vivado binary artifacts
*.dcp
synth/.Xil/
synth/clockInfo.txt
synth/tight_setup_hold_pins.txt
